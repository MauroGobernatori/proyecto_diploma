generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- ENUMS ---

enum NivelRol {
  PLATAFORMA
  CURSO
  GRUPO
}

enum EstadoCurso {
  CREADO
  EN_CURSO
  FINALIZADO
  ELIMINADO
}

enum TipoRecurso {
  LINK
  VIDEO
  DOCUMENTO
  ACTIVIDAD
  EVALUACION
}

enum EstadoRecompensa {
  ACTIVO
  INACTIVO
  ELIMINADO
}

// --- USUARIOS, ROLES Y PERMISOS (RBAC DINÁMICO) ---

model Usuario {
  id          String   @id @default(cuid())
  usuario     String   @unique
  contrasenia String
  nombre      String
  apellido    String
  email       String   @unique
  edad        Int?
  empresa     String?
  institucion String?
  dni         String?
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  // Relaciones
  roles                UsuarioRol[]
  recompensasObtenidas RecompensaObtenida[]
  reportes             Reporte[]
}

model Permiso {
  id          String   @id @default(cuid())
  nombre      String   // Ej: "Crear curso"
  clave       String   @unique // Ej: "curso:crear"
  categoria   String?  // Ej: "Gestión de Cursos"
  
  roles       RolPermiso[]
}

model Rol {
  id          String   @id @default(cuid())
  nombre      String   // Ej: "Administrador", "Docente", "Jefe de Grupo"
  nivel       NivelRol @default(PLATAFORMA)
  esSistema   Boolean  @default(false) // Si es true, no se puede eliminar por el admin

  permisos    RolPermiso[]
  usuarios    UsuarioRol[]
  
  @@unique([nombre, nivel])
}

model RolPermiso {
  rolId     String
  permisoId String

  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso   Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
}

model UsuarioRol {
  id        String   @id @default(cuid())
  usuarioId String
  rolId     String
  
  // Scopes opcionales (Si el rol es a nivel de Curso o Grupo)
  cursoId   String?
  grupoId   String?

  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  curso     Curso?  @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  grupo     Grupo?  @relation(fields: [grupoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, rolId, cursoId, grupoId])
}

// --- CURSOS Y CONTENIDOS ---

model Curso {
  id                 String      @id @default(cuid())
  nombre             String
  descripcion        String
  logo               String?
  fechaInicio        DateTime?
  fechaFin           DateTime?
  tema               String?
  formato            String?
  matriculacionLibre Boolean     @default(false)
  visibilidad        Boolean     @default(true) // Ocultar/mostrar
  estado             EstadoCurso @default(CREADO)
  creadoEn           DateTime    @default(now())

  secciones   Seccion[]
  usuarios    UsuarioRol[]
  recompensas Recompensa[]
  reportes    Reporte[]
}

model Seccion {
  id      String @id @default(cuid())
  nombre  String
  orden   Int    @default(1)
  cursoId String

  curso    Curso     @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  recursos Recurso[]
}

model Recurso {
  id          String      @id @default(cuid())
  nombre      String
  descripcion String?
  tipo        TipoRecurso
  url         String?
  orden       Int         @default(1)
  estado      Boolean     @default(true)
  seccionId   String

  seccion Seccion @relation(fields: [seccionId], references: [id], onDelete: Cascade)
}

// --- GRUPOS ---

model Grupo {
  id            String       @id @default(cuid())
  nombre        String
  fechaCreacion DateTime     @default(now())
  usuarios      UsuarioRol[]
  reportes      Reporte[]
}

// --- RECOMPENSAS ---

model Recompensa {
  id                    String           @id @default(cuid())
  nombre                String
  descripcion           String
  fechaHabilitacion     DateTime
  fechaInhabilitacion   DateTime
  otorgamientoMultiple  Boolean          @default(false)
  requiereTodosLosCursos Boolean         @default(false) // Si es true, requiere completar TODOS los cursos vinculados
  estado                EstadoRecompensa @default(ACTIVO)
  creadoEn              DateTime         @default(now())

  cursos       Curso[]
  obtenidasPor RecompensaObtenida[]
}

model RecompensaObtenida {
  id             String     @id @default(cuid())
  usuarioId      String
  recompensaId   String
  fechaObtencion DateTime   @default(now())

  usuario    Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  recompensa Recompensa @relation(fields: [recompensaId], references: [id], onDelete: Cascade)
}

// --- REPORTES (Para cumplimiento formal con la materia) ---

model Reporte {
  id            String   @id @default(cuid())
  nombre        String
  tipo          String   // Ej: "Progreso Cursos", "Actividad Usuario"
  fechaCreacion DateTime @default(now())
  
  usuarioId     String?
  cursoId       String?
  grupoId       String?

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  curso   Curso?   @relation(fields: [cursoId], references: [id], onDelete: SetNull)
  grupo   Grupo?   @relation(fields: [grupoId], references: [id], onDelete: SetNull)
}
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- ENUMS ---

enum RolPlataforma {
  ADMINISTRADOR
  GESTOR
  GENERAL
}

enum RolCurso {
  DOCENTE
  ALUMNO
}

enum EstadoCurso {
  CREADO
  EN_CURSO
  FINALIZADO
  ELIMINADO
}

enum EstadoRecompensa {
  ACTIVO
  INACTIVO
  ELIMINADO
}

// --- MODELOS DE USUARIO Y ROLES ---

model Usuario {
  id            Int           @id @default(autoincrement())
  usuario       String        @unique
  contrasenia   String
  nombre        String
  apellido      String
  email         String        @unique
  edad          Int?
  empresa       String?
  institucion   String?
  dni           String?
  rolPlataforma RolPlataforma @default(GENERAL)
  creadoEn      DateTime      @default(now())

  // Relaciones
  cursosInscriptos     UsuarioCurso[]
  grupos               UsuarioGrupo[]
  recompensasObtenidas RecompensaObtenida[]
}

// --- MODELOS DE CURSOS Y CONTENIDOS ---

model Curso {
  id                Int         @id @default(autoincrement())
  nombre            String
  descripcion       String
  logo              String?
  fechaInicio       DateTime?
  fechaFin          DateTime?
  tema              String?
  formato           String?
  matriculacionLibre Boolean    @default(false)
  visibilidad       Boolean     @default(true)
  estado            EstadoCurso @default(CREADO)
  creadoEn          DateTime    @default(now())

  // Relaciones
  secciones   Seccion[]
  usuarios    UsuarioCurso[]
  recompensas Recompensa[] // Relación M:N implícita con Recompensa
}

model UsuarioCurso {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  cursoId   Int
  rol       RolCurso @default(ALUMNO)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  curso   Curso   @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, cursoId])
}

model Seccion {
  id      Int    @id @default(autoincrement())
  nombre  String
  orden   Int    @default(1)
  cursoId Int

  curso    Curso     @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  recursos Recurso[]
}

model Recurso {
  id          Int     @id @default(autoincrement())
  nombre      String
  descripcion String?
  tipo        String  // Link, Video, Documento, Actividad, Evaluacion
  url         String?
  orden       Int     @default(1)
  estado      Boolean @default(true)
  seccionId   Int

  seccion Seccion @relation(fields: [seccionId], references: [id], onDelete: Cascade)
}

// --- MODELOS DE GRUPOS DE TRABAJO/USUARIOS ---

model Grupo {
  id            Int            @id @default(autoincrement())
  nombre        String
  fechaCreacion DateTime       @default(now())
  usuarios      UsuarioGrupo[]
}

model UsuarioGrupo {
  id        Int    @id @default(autoincrement())
  usuarioId Int
  grupoId   Int
  rol       String // Jefe, Integrante

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  grupo   Grupo   @relation(fields: [grupoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, grupoId])
}

// --- MODELOS DE RECOMPENSAS ---

model Recompensa {
  id                   Int              @id @default(autoincrement())
  nombre               String
  descripcion          String
  fechaHabilitacion    DateTime
  fechaInhabilitacion  DateTime
  otorgamientoMultiple Boolean          @default(false)
  estado               EstadoRecompensa @default(ACTIVO)
  creadoEn             DateTime         @default(now())

  // Relaciones
  cursos       Curso[]              // Recompensa vinculada a 1 o N cursos (RF-32)
  obtenidasPor RecompensaObtenida[] // Registro de quién la obtuvo
}

model RecompensaObtenida {
  id             Int        @id @default(autoincrement())
  usuarioId      Int
  recompensaId   Int
  fechaObtencion DateTime   @default(now())

  usuario    Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  recompensa Recompensa @relation(fields: [recompensaId], references: [id], onDelete: Cascade)
}